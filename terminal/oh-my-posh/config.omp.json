{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "base": "#eff1f5",
    "text": "#4c4f69",
    "mauve": "#8839ef",
    "blue": "#1e66f5",
    "green": "#40a02b",
    "peach": "#fe640b",
    "red": "#d20f39",
    "yellow": "#df8e1d",
    "teal": "#179299",
    "subtext0": "#6c6f85"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "╭─",
          "trailing_diamond": "",
          "foreground": "p:base",
          "background": "p:mauve",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:base",
          "background": "p:blue",
          "properties": {
            "style": "folder",
            "max_depth": 3,
            "folder_icon": "…"
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:base",
          "background": "p:green",
          "background_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:teal{{ end }}",
            "{{ if gt .Behind 0 }}p:yellow{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:peach{{ end }}"
          ],
          "properties": {
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:subtext0",
          "properties": {
            "threshold": 500,
            "style": "round"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "exit",
          "style": "plain",
          "foreground": "p:green",
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if gt .Code 0 }}<p:red> {{ .Code }}</>{{ else }} {{ end }}"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:subtext0",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": " 󰥔 {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:mauve",
          "template": "╰─▶ "
        }
      ]
    }
  ]
}
